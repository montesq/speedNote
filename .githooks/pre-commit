#!/bin/bash
# Incrémente le patch (Z) de VERSION (format X.Y.Z) à chaque commit et
# l'inclut dans le commit en cours. X et Y se changent à la main pour une
# version majeure/mineure. Activé via `git config core.hooksPath .githooks`
# (une seule fois par clone).
set -e

REPO_DIR="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_DIR/VERSION"

version="$(cat "$VERSION_FILE" 2>/dev/null || echo 0.0.0)"
IFS='.' read -r major minor patch <<< "$version"
patch=$(( ${patch:-0} + 1 ))
echo "${major:-0}.${minor:-0}.$patch" > "$VERSION_FILE"

git add "$VERSION_FILE"

#!/bin/bash
# Incrémente VERSION à chaque commit et l'inclut dans le commit en cours.
# Activé via `git config core.hooksPath .githooks` (une seule fois par clone).
set -e

REPO_DIR="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_DIR/VERSION"

version="$(cat "$VERSION_FILE" 2>/dev/null || echo 0)"
version=$((version + 1))
echo "$version" > "$VERSION_FILE"

git add "$VERSION_FILE"
